{
  "name": "web-arpg",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "common",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @arpg/server\" \"npm run dev -w @arpg/client\"",
    "dev:server": "npm run dev -w @arpg/server",
    "dev:client": "npm run dev -w @arpg/client",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
